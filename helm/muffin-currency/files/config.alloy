loki.source.file "json_logs" {
  targets = local.file_match.find_logs.targets
  forward_to = [loki.process.json_parser.receiver]
}

local.file_match "find_logs" {
    path_targets = [{"__path__" = "/var/log/app/*.log"}]
}

loki.process "json_parser" {
  stage.json {
    expressions = {
      time = "time",
      level = "level",
      msg = "msg",
      method = "path",
      path = "path",
      traceId = "trace_id",
      spanId = "span_id",
    }
  }

  stage.output {
    source = "msg"
  }

  stage.labels {
    values = {
      level = "",
      traceId = "",
      spanId = "",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339"
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
  }
  external_labels = {
    namespace = "default",
    app = "muffin-currency",
  }
}
